{#- Llama-3-style chat template with {% generation %} markers for assistant-only
    loss masking, adapted from trl/chat_templates/llama3_training.jinja. Renders
    each message as a `<|start_header_id|>ROLE<|end_header_id|>\n\nCONTENT<|eot_id|>`
    block, in role order (an optional leading system turn, then alternating
    user/assistant), matching the `messages` schema produced by
    prepare_sft_data.py.
-#}
{%- for message in messages %}
    {%- if loop.index0 == 0 %}{{- bos_token }}{%- endif %}
    {%- if message['role'] == 'assistant' %}
        {{- '<|start_header_id|>assistant<|end_header_id|>\n\n' }}
        {%- generation %}
        {{- message['content'] | trim + '<|eot_id|>' }}
        {%- endgeneration %}
    {%- else %}
        {{- '<|start_header_id|>' + message['role'] + '<|end_header_id|>\n\n' + message['content'] | trim + '<|eot_id|>' }}
    {%- endif %}
{%- endfor %}
{%- if add_generation_prompt %}
    {{- '<|start_header_id|>assistant<|end_header_id|>\n\n' }}
{%- endif %}
